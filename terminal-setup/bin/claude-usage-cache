#!/usr/bin/env python3
"""Claude Code statusLine wrapper: caches rate-limit % for the tmux bar.
Zero API calls - it only re-uses the JSON Claude Code already pipes to its
statusline. Usage in ~/.claude/settings.json:
  "statusLine": {"type":"command","command":"~/.local/bin/claude-usage-cache [your old statusline cmd]"}
"""
import json, os, subprocess, sys, time

CACHE = os.environ.get("CLAUDE_USAGE_CACHE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "claude-usage.json")
raw = sys.stdin.read()

def save():
    try:
        rl = (json.loads(raw).get("rate_limits") or {})
        keys = ("five_hour", "seven_day")
        try:
            old = json.load(open(CACHE))
        except Exception:
            old = {}
        new = dict(old)
        for k in keys:
            w = rl.get(k)
            if isinstance(w, dict) and w.get("used_percentage") is not None:
                new[k] = {"used_percentage": w["used_percentage"], "resets_at": w.get("resets_at")}
        changed = any(new.get(k) != old.get(k) for k in keys)
        if changed or time.time() - old.get("updated", 0) > 60:   # throttle disk writes
            new["updated"] = time.time()
            os.makedirs(os.path.dirname(CACHE), exist_ok=True)
            tmp = CACHE + ".%d" % os.getpid()
            json.dump(new, open(tmp, "w"))
            os.replace(tmp, CACHE)
    except Exception:
        pass                      # never break the statusline

save()
cmd = " ".join(sys.argv[1:]).strip()
if cmd:
    sys.exit(subprocess.run(cmd, shell=True, input=raw, text=True).returncode)
try:
    rl = json.loads(raw).get("rate_limits") or {}
    out = [f"{l} {round(rl[k]['used_percentage'])}%" for k, l in (("five_hour", "5h"), ("seven_day", "7d")) if k in rl]
    print(" · ".join(out))
except Exception:
    pass
