# ~/.config/ghostty/config  (symlink -> ~/dotfiles/terminal-setup/ghostty-config)
font-family = "JetBrainsMono Nerd Font"
font-size = 10.5
theme = Catppuccin Mocha

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
window-width = 147
window-height = 67

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-write = allow

# tmux owns persistence; Ghostty must not restore its own tabs
# (each restored tab would spawn an extra tmux window).
window-save-state = never
window-inherit-working-directory = true
confirm-close-surface = false

# every new Ghostty window/tab -> new tmux window next to the old ones
command = /home/maciekgangus/.local/bin/tmux-start
